{
  "name": "@snt/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Web UI: React components, CSS Modules, design tokens and icons. Web-only — CSS Modules and DOM elements cannot be used by React Native, so anything a native app also needs belongs in @snt/core.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./icons": "./src/icons/index.tsx",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/reset.css": "./src/styles/reset.css"
  },
  "scripts": {
    "lint": "echo \"@snt/ui: no linter configured yet\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules *.tsbuildinfo"
  },
  "dependencies": {
    "@snt/core": "workspace:*",
    "sonner": "^2.0.8"
  },
  "peerDependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
